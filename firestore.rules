rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function householdPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId);
    }

    function isMemberOf(householdId) {
      return signedIn() && uid() in get(householdPath(householdId)).data.memberIds;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isNonEmptyString(value, maxSize) {
      return value is string && value.size() > 0 && value.size() <= maxSize;
    }

    function isOptionalString(data, key, maxSize) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxSize);
    }

    // Limits mirror the client (src/features/items/model.ts, src/features/household/model.ts).
    function isValidItem(data) {
      return data.keys().hasOnly(['name', 'section', 'needed', 'quantity', 'note', 'inCart', 'flaggedBy', 'updatedAt'])
        && isNonEmptyString(data.name, 80)
        && isNonEmptyString(data.section, 40)
        && data.needed is bool
        && isOptionalString(data, 'quantity', 40)
        && isOptionalString(data, 'note', 60)
        && (!('inCart' in data) || data.inCart is bool)
        && (!('flaggedBy' in data) || data.flaggedBy == null || isNonEmptyString(data.flaggedBy, 128))
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    match /users/{userId} {
      allow read, delete: if signedIn() && uid() == userId;
      allow create, update: if signedIn() && uid() == userId
        && request.resource.data.keys().hasOnly(['activeHouseholdId'])
        && (request.resource.data.activeHouseholdId == null
          || isNonEmptyString(request.resource.data.activeHouseholdId, 64));
    }

    match /households/{householdId} {
      function isMember() {
        return signedIn() && uid() in resource.data.memberIds;
      }

      function isOwner() {
        return signedIn() && resource.data.ownerId == uid();
      }

      function isValidHousehold(data) {
        return data.keys().hasOnly(['name', 'ownerId', 'memberIds', 'members', 'sections', 'inviteCode', 'joinCode', 'createdAt'])
          && isNonEmptyString(data.name, 60)
          && data.sections is list
          && data.sections.size() <= 40
          && data.memberIds is list
          && data.memberIds.size() <= 20
          && data.members is map
          && isNonEmptyString(data.inviteCode, 64);
      }

      function isMemberEdit() {
        return isMember()
          && !changedKeys().hasAny(['ownerId', 'joinCode'])
          && (isOwner() || !changedKeys().hasAny(['memberIds', 'members']))
          && uid() in request.resource.data.memberIds
          && isValidHousehold(request.resource.data);
      }

      // A member may remove only themselves; an owner leaving must hand ownership to a remaining member.
      function isLeaving() {
        let before = resource.data;
        let after = request.resource.data;
        return isMember()
          && changedKeys().hasOnly(['memberIds', 'members', 'ownerId'])
          && after.memberIds.size() == before.memberIds.size() - 1
          && after.memberIds.toSet() == before.memberIds.toSet().difference([uid()].toSet())
          && before.members.diff(after.members).affectedKeys().hasOnly([uid()])
          && (isOwner() ? after.ownerId in after.memberIds : after.ownerId == before.ownerId);
      }

      // A non-member may only append themselves, proving they hold the current invite code.
      function isJoining() {
        let before = resource.data;
        let after = request.resource.data;
        return signedIn()
          && !isMember()
          && changedKeys().hasOnly(['memberIds', 'members', 'joinCode'])
          && after.joinCode == before.inviteCode
          && after.memberIds.size() == before.memberIds.size() + 1
          && after.memberIds.size() <= 20
          && after.memberIds.toSet() == before.memberIds.toSet().union([uid()].toSet())
          && after.members.diff(before.members).affectedKeys().hasOnly([uid()]);
      }

      // A missing document reveals nothing; allowing it lets the creator listen before the creation syncs.
      allow read: if resource == null || isMember();
      allow create: if signedIn()
        && request.resource.data.ownerId == uid()
        && request.resource.data.memberIds == [uid()]
        && request.resource.data.members.keys().hasOnly([uid()])
        && isValidHousehold(request.resource.data);
      allow update: if isMemberEdit() || isJoining() || isLeaving();
      allow delete: if isOwner() || (isMember() && resource.data.memberIds.size() == 1);

      match /items/{itemId} {
        allow read, delete: if isMemberOf(householdId);
        allow create, update: if isMemberOf(householdId) && isValidItem(request.resource.data);
      }
    }
  }
}
